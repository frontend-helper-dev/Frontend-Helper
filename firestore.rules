rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // AI config — читати всі, писати тільки адмін
    match /ai-config/{document} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'nikita99didorenko@gmail.com';
    }

    // AI history — писати авторизовані, читати тільки адмін
    match /ai-history/{document} {
      allow create: if true;
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'nikita99didorenko@gmail.com';
    }

    // Решта — авторизовані
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
